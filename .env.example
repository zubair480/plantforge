# Copy to .env.local for local runs, or set these as env vars / secrets in your cloud host.
# Never commit real values.

# --- Used by scripts, the autopilot container, and the MCP server ---
INSFORGE_FUNCTIONS_URL=https://nden3esm.us-west.insforge.app/functions
AGENT_API_TOKEN=            # x-agent-token for agent-facing functions (MCP server)
PLANT_INGEST_TOKEN=         # x-plant-token for plant-ingest (Ignition / simulator)
MCP_URL=https://dark-forge-tma6f.run.mcp-use.com/mcp

# --- Approval page (public values, safe in a browser) ---
VITE_INSFORGE_URL=https://nden3esm.us-west.insforge.app
VITE_INSFORGE_ANON_KEY=

# --- CI / headless deploys (scripts/deploy.sh) ---
INSFORGE_ACCESS_TOKEN=      # InsForge user API key (dashboard: Profile -> API Keys)
INSFORGE_PROJECT_ID=d7b0a23f-d743-43f7-a33d-c4fc0d308169

# --- InsForge function secrets (set with: npx -y @insforge/cli secrets add NAME VALUE) ---
# AGENT_API_TOKEN, PLANT_INGEST_TOKEN, OPENROUTER_API_KEY, OPENROUTER_CHAT_MODEL (optional)
# PRIMITIVE_API_KEY, PRIMITIVE_WEBHOOK_SECRET, PRIMITIVE_FROM
# STRIPE_PRICE_PER_DOLLAR, STRIPE_PRICE_PER_CENT, APPROVAL_PAGE_URL, PLANT_TIMEZONE (optional)
# INKBOX_API_KEY, INKBOX_IDENTITY_ID, MANAGER_PHONE
# Functions read secrets at deploy time: redeploy after changing one.
